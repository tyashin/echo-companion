; Engine configuration file.
; It's best edited using the editor UI and not directly.

config_version=5

[application]

config/name="Echo Companion"
config/description="Always-on AI companion client (Phase 0 skeleton)."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]

; Dev-environment bridge for the Godot MCP server (agent-driven run/debug,
; scene-tree inspection, screenshots). Listens on 127.0.0.1:9090 while the
; game runs. Not part of the game logic.
McpInteractionServer="*res://scripts/mcp_interaction_server.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=800

[rendering]

renderer/rendering_method="forward_plus"
