# Copy to .env and adjust. All Settings fields are required — the app fails
# to start if any are missing.

DEBUG=true
# Async driver (asyncpg) for the app, sync driver (psycopg2) for Alembic.
DATABASE_URL=postgresql+asyncpg://echo:echo@localhost:5432/echo
DATABASE_SYNC_URL=postgresql+psycopg2://echo:echo@localhost:5432/echo

# Neo4j (docker-compose ports: default 7474/7687 are taken on the dev PC)
NEO4J_URI=bolt://localhost:17687
NEO4J_USER=neo4j
NEO4J_PASSWORD=echo-graph-dev

# Server
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
